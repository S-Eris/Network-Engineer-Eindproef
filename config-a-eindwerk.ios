exit

router ospf 1
 default-information originate always
exit

router ospf 1
 redistribute bgp 65001 subnets
exit

do write memory

!*******************************************************************************
!!Distri-Switch1
!!*******************************************************************************

!! basic config
enable
configure terminal

no ip domain-lookup

line console 0
logging synchronous
exit

line vty 0 15
! exec-timeout 0 0  
logging synchronous
exit

hostname Distri-Switch1

vlan 10
 name MGMT
vlan 20
 name OFFICE
vlan 30
 name IT
vlan 40
 name SALES
vlan 99
 name NATIVE_VLAN
exit

ip routing

!load balancing kan ook geconfigureerd worden via HSRP vlan 30,40 prio 110 distri-sw-1

interface vlan 10
 description GATEWAY-MGMT
 standby 10 timers 1 3
 ip address 10.10.10.2 255.255.255.0
 standby 10 ip 10.10.10.254
 standby 10 priority 110
 standby 10 preempt
 no shutdown
exit

interface vlan 20
 description GATEWAY-OFFICE
 standby 20 timers 1 3
 ip address 10.10.20.2 255.255.255.0
 standby 20 ip 10.10.20.254
 standby 20 priority 110
 standby 20 preempt
 no shutdown
exit

interface vlan 30
 description GATEWAY-IT
 standby 30 timers 1 3
 ip address 10.10.30.2 255.255.255.0
 standby 30 ip 10.10.30.254
 standby 30 priority 110
 standby 30 preempt
 no shutdown
exit

interface vlan 40
 description GATEWAY-SALES
 standby 40 timers 1 3
 ip address 10.10.40.2 255.255.255.0
 standby 40 ip 10.10.40.254
 standby 40 priority 110
 standby 40 preempt
 no shutdown
exit

spanning-tree mode rapid-pvst
spanning-tree pathcost method long
spanning-tree portfast edge bpduguard default
spanning-tree vlan 1-4094 priority 8192

interface range gi0/1-2
channel-group 10 mode active

interface port-channel 10
 description LACP-LINK-TO-DISTRI-SW-2
    switchport trunk encapsulation dot1q
    switchport mode trunk
    switchport nonegotiate
    switchport trunk allowed vlan 10,20,30,40,99
    switchport trunk native vlan 99
exit

interface range Gi1/0-2
 description LINK-TO-ACCESS-SWITCHES
    switchport trunk encapsulation dot1q
    switchport mode trunk
    switchport trunk allowed vlan 10,20,30,40,99
    switchport trunk native vlan 99
    no shutdown
exit

interface gi0/0
 description LINK-TO-R-CORE-1
 no switchport
 ip address 10.0.0.6 255.255.255.252
 no shutdown
exit

router ospf 1
 router-id 10.10.10.1

 network 10.10.10.0 0.0.0.255 area 0
 network 10.10.20.0 0.0.0.255 area 0
 network 10.10.30.0 0.0.0.255 area 0
 network 10.10.40.0 0.0.0.255 area 0

 network 10.0.0.4 0.0.0.3 area 0
exit

!router ospf 1
! passive-interface default
! no passive-interface gi0/0

do write memory



