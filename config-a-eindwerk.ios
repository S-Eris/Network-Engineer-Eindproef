vlan 30
 name IT
vlan 40
 name SALES
vlan 99
 name NATIVE_VLAN
exit

ip routing

!load balancing via HSRP vlan 30,40 prio 110 distri-sw-2

interface vlan 10
 description GATEWAY-MGMT
 standby 10 timers 1 3
 ip address 10.10.10.3 255.255.255.0
 standby 10 ip 10.10.10.254
 standby 10 priority 90
 standby 10 preempt
 no shutdown
exit

interface vlan 20
 description GATEWAY-OFFICE
 standby 20 timers 1 3
 ip address 10.10.20.3 255.255.255.0
 standby 20 ip 10.10.20.254
 standby 20 priority 90
 standby 20 preempt
 no shutdown
exit

interface vlan 30
 description GATEWAY-IT
 standby 30 timers 1 3
 ip address 10.10.30.3 255.255.255.0
 standby 30 ip 10.10.30.254
 standby 30 priority 90
 standby 30 preempt
 no shutdown
exit

interface vlan 40
 description GATEWAY-SALES
 standby 40 timers 1 3
 ip address 10.10.40.3 255.255.255.0
 standby 40 ip 10.10.40.254
 standby 40 priority 90
 standby 40 preempt
 no shutdown
exit


spanning-tree mode rapid-pvst
spanning-tree pathcost method long
spanning-tree portfast edge bpduguard default
spanning-tree vlan 1-4094 priority 16384

interface range gi0/1-2
channel-group 10 mode active

interface port-channel 10
 description LACP-LINK-TO-DISTRI-SW-1
    switchport trunk encapsulation dot1q
    switchport mode trunk
    switchport nonegotiate
    switchport trunk allowed vlan 10,20,30,40,99
    switchport trunk native vlan 99
    no shutdown
exit

interface range Gi1/1-3
 description LINK-TO-ACCESS-SWITCHES
    switchport trunk encapsulation dot1q
    switchport mode trunk
    switchport trunk allowed vlan 10,20,30,40,99
    switchport trunk native vlan 99
no shutdown
exit

interface gi0/0
 description LINK-TO-R-CORE-2
 no switchport
 ip address 10.0.0.10 255.255.255.252
 no shutdown
exit

router ospf 1
 router-id 20.20.20.1

 network 10.10.10.0 0.0.0.255 area 0
 network 10.10.20.0 0.0.0.255 area 0
 network 10.10.30.0 0.0.0.255 area 0
 network 10.10.40.0 0.0.0.255 area 0

 network 10.0.0.8 0.0.0.3 area 0
exit

!router ospf 1
! passive-interface default
! no passive-interface gi0/0

do write memory



!*******************************************************************************
!!Access-Switch1
!!*******************************************************************************
!! basic config 
enable
configure terminal

no ip domain-lookup

line console 0
logging synchronous
exit

line vty 0 15
! exec-timeout 0 0
logging synchronous
exit

hostname Access-Switch1

vlan 10
 name MGMT
vlan 99
 name NATIVE_VLAN
exit

interface vlan 10
no shutdown
exit

spanning-tree mode rapid-pvst
spanning-tree pathcost method long
spanning-tree portfast edge bpduguard default

interface range Gi0/0-1
 description END-DEVICES-MGMT
    switchport mode access
    switchport access vlan 10
    no shutdown
exit

interface range Gi1/0-1
 description UPLINK-TO-DISTRIBUTION-SWITCHES
    switchport trunk encapsulation dot1q
    switchport mode trunk
    switchport trunk allowed vlan 10,20,30,40,99
    switchport trunk native vlan 99
    no shutdown
exit

do write memory


