exit

interface gi0/0
 description LINK-TO-WAN
 ip address 10.255.1.6 255.255.255.252
 no shutdown
exit

router bgp 65003
 neighbor 10.255.0.5 remote-as 65001
 neighbor 10.255.1.5 remote-as 65000
! neighbor 10.255.0.5 default-originate
exit

router bgp 65003
 network 10.255.0.4 mask 255.255.255.252
 network 10.255.1.4 mask 255.255.255.252
exit

ip route 0.0.0.0 0.0.0.0 10.255.1.5

do write memory

!********************************************
!! R-CORE-1
!!********************************************
! base config
enable
configure terminal

no ip domain-lookup

ip routing

hostname R-CORE-1

enable secret cisco
service password-encryption

ip domain-name cisco.local
username admin secret cisco
crypto key generate rsa general-keys modulus 1024
ip ssh version 2

line console 0
logging synchronous
exit

line vty 0 15
login local
transport input ssh
exec-timeout 0 0
logging synchronous
exit


interface gi0/3
 description LINK-TO-R-CORE-2
 ip address 10.0.0.1 255.255.255.252
 no shutdown
exit

interface gi0/1
 description LINK-TO-DISTRI-SW1
 ip address 10.0.0.5 255.255.255.252
 no shutdown
exit

interface gi0/0
 description LINK-TO-TELENET
 ip address 10.255.0.1 255.255.255.252
 no shutdown
exit

!ip route 0.0.0.0 0.0.0.0 10.255.0.2

router ospf 1
 router-id 1.1.1.1
 network 10.0.0.0 0.0.0.3 area 0
 network 10.0.0.4 0.0.0.3 area 0
 network 10.10.0.0 0.0.255.255 area 0
exit

!router ospf 1
! passive-interface default
! no passive-interface gi0/1

router bgp 65001
 neighbor 10.255.0.2 remote-as 65002
 network 10.10.0.0 mask 255.255.0.0
exit

router ospf 1
 default-information originate always
exit

router ospf 1
 redistribute bgp 65001 subnets
exit

do write memory

!********************************************
!! R-CORE-2
!!********************************************
! base config
enable
configure terminal

no ip domain-lookup

